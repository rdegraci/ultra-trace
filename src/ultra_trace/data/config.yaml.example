# Ultra-Trace user defaults (tunable knobs).
# Copied to the user app directory on first run if missing:
#   ~/Library/Application Support/ultra-trace/config.yaml
#
# Precedence (highest → lowest):
#   1. CLI flags
#   2. Project config (--config / repo ultra-trace.yml)
#   3. This user config (~/Library/Application Support/ultra-trace/config.yaml)
#   4. Built-in defaults
#
# Secrets do NOT go here. Use ~/Library/Application Support/ultra-trace/.env (from dot_env.example).

# Path exploration
maxDepth: 12

# Repository discovery (project config usually overrides these)
includePaths: []
excludePaths:
  - .git
  - DerivedData
  - .build
  - Pods
  - Carthage
  - SourcePackages

focusModules: []

# Analysis modes: core always; advanced when SIL/Xcode deepening is available
analysisModes:
  - core

# Reporting
severityThreshold: medium
proofMode: mixed
outputFormats:
  - markdown
  - json

# Privacy / LLM assist (keys in ~/Library/Application Support/ultra-trace/.env)
# Recommended nightly / CI default: offline + llm.enabled false (no key required).
# To enable assist safely:
#   1. Keep secrets only in ~/Library/Application Support/ultra-trace/.env
#   2. Set privacyMode to redacted (minimized prompts) or full-assist
#   3. Set llm.enabled true, provider, and model
#   4. LLM output is advisory only — it cannot create findings or set severity
privacyMode: offline
llm:
  enabled: false
  provider: openai
  model: ""
  baseURL: ""
  apiKeyEnvVar: ULTRA_TRACE_LLM_API_KEY
  timeoutSeconds: 60
  allowedFeatures:
    - exploration_planning
    - remediation_wording
    - reproduction_drafting
    - report_summary
    - proof_prose_polishing

# Shallow taint (starter iOS catalog). Override per project.
# Empty lists disable matching for that category.
sourcePatterns:
  - UITextField.text
  - UITextView.text
  - UISearchBar.text
  - URLQueryItem.value
  - URLComponents.query
  - URLComponents.queryItems
  - ProcessInfo.environment
  - CommandLine.arguments
  - UserDefaults.string
  - UserDefaults.object
  - WKScriptMessage.body
  - Notification.userInfo
  - JSONSerialization.jsonObject
sinkPatterns:
  - FileManager.default.createFile
  - FileManager.createFile
  - createFile
  - "write(to:"
  - String.write
  - Data.write
  - URLSession.shared.dataTask
  - URLSession.dataTask
  - dataTask
  - WKWebView.loadHTMLString
  - loadHTMLString
  - evaluateJavaScript
  - NSPredicate
  - Process.launch
sanitizerPatterns:
  - addingPercentEncoding
  - "addingPercentEncoding(withAllowedCharacters"
  - standardizedFileURL
  - resolvingSymlinksInPath
  - standardized
  - escaped
  - sanitized

# Swift Core frontend
swiftFrontend:
  helperPath: null
  parserVersion: null
  toolchainPath: null
  supportedSubsetMode: core
  helperTimeoutSeconds: 120

# Advanced / SIL (final shape; ignored safely in MVP)
advanced:
  enabled: false
  silToolchainPath: null

# Call-summary budget (foundation in MVP; descent later)
callSummary:
  enabled: false
  maxDepth: 0
